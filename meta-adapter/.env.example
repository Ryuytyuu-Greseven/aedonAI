# Server
PORT=3000

# MongoDB — must point at the SAME database as lyreai_agent_builder_server.
# meta-adapter reads its `users` and `revoked_tokens` collections (read-only)
# to verify JWTs, in addition to owning its own connected-page/lead collections.
MONGODB_URI=mongodb://localhost:27017/agent_builder

# Must be identical to lyreai_agent_builder_server's JWT_SECRET — this service
# only verifies tokens issued there, it never issues its own.
JWT_SECRET=replace-with-a-long-random-secret

# Meta App credentials (https://developers.facebook.com/apps)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4200/auth/facebook/callback

# Arbitrary string you choose; must match the "Verify Token" configured
# in the Meta App's Webhooks product settings
META_VERIFY_TOKEN=

# Shared secret for service-to-service calls (sent as the x-internal-api-key
# header), e.g. the cron that triggers POST /meta/leads/sync
INTERNAL_API_KEY=replace-with-a-long-random-secret

# How far back the lead sync looks for a Page that has never been polled
META_LEAD_SYNC_LOOKBACK_HOURS=24

# In-process cron that polls Meta for leads the webhook missed and stores
# them in meta_leads (it does not dial them). Standard 5-field cron syntax.
META_LEAD_SYNC_ENABLED=true
META_LEAD_SYNC_CRON=*/5 * * * *
