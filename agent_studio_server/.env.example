# agent_studio_server — Studio backend API
# Copy to .env and fill in the blanks. Never commit .env.

PORT=2000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4310
FRONTEND_URL=http://localhost:4310

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1d
RESET_PASSWORD_TOKEN_TTL_MINUTES=
# Seeded admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional — command-control notifications recipient (code default applies)
# COMMAND_CONTROL_EMAIL=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Other services ──────────────────────────────────────────────────────────
# calls_input_gateway (previews / outbound calls)
AUDIO_PROCESSOR_URL=http://localhost:3100
# Must match INTERNAL_API_KEY on calls_input_gateway
CALLS_GATEWAY_API_KEY=
META_ADAPTER_URL=http://localhost:2005

# ── Google / Gemini ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_LOCATION_US=us-central1
GOOGLE_CLOUD_LOCATION_IN=asia-south1
GOOGLE_CLOUD_STT_RECOGNIZER_ID=
GOOGLE_GENAI_USE_ENTERPRISE=True
GCS_BUCKET_NAME=

# ── Knowledge bases (embeddings + Pinecone) ─────────────────────────────────
# vertex-ai | openai
EMBEDDING_PROVIDER=vertex-ai
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
# Optional — KB text formatting model (code default applies)
# VERTEX_AI_CHAT_MODEL=
PINECONE_API_KEY=
PINECONE_INDEX=lyreai
# Only when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=
# OPENAI_CHAT_MODEL=

# ── Telephony: Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WS_URL=wss://<calls-gateway-host>
TWILIO_WEBHOOK_URL=https://<calls-gateway-host>

# ── Telephony: Exotel ───────────────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=
EXOTEL_WS_URL=wss://<calls-gateway-host>
# api.exotel.com (Singapore) | api.in.exotel.com (Mumbai)
# EXOTEL_API_HOST=api.in.exotel.com
# App Bazaar flow assigned to purchased ExoPhones
# EXOTEL_VOICE_FLOW_URL=
