# calls_input_gateway — telephony + voice pipeline (Twilio, Exotel, /ws web calls)
# Copy to .env and fill in the blanks. Never commit .env.

PORT=3100

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Internal auth ───────────────────────────────────────────────────────────
# Required header (x-internal-api-key) on POST /calls and /twilio/call.
# agent_studio_server and meta-adapter send it as CALLS_GATEWAY_API_KEY.
INTERNAL_API_KEY=
# meta-adapter (lead dialer): receives each outbound call's outcome so it can
# retry missed calls. Leave unset to skip reporting.
# META_ADAPTER_URL=https://<meta-adapter-host>
# meta-adapter's INTERNAL_API_KEY (sent as x-internal-api-key)
# INTERNAL_API_KEY=
CALLS_GATEWAY_API_KEY=

# ── Domain agent servers (business → WebSocket URL) ─────────────────────────
DEFAULT_AGENT=ecom-customer-service
HIRING_AGENT_URL=ws://localhost:4001
ALERTING_AGENT_URL=ws://localhost:4002
CUSTOMER_SUPPORT_AGENT_URL=ws://localhost:4003
INSURANCE_AGENT_URL=ws://localhost:4004
# Registry key `lovebyt` reads LOVEBYT_AGENT_URL; LOBSTER_AGENT_URL is
# present in .env but not read by the code.
LOVEBYT_AGENT_URL=ws://localhost:4005
LOBSTER_AGENT_URL=ws://localhost:4005
SALES_AGENT_URL=ws://localhost:4006
CREDITCARDS_AGENT_URL=ws://localhost:4007
ECOM_CUTOMER_SERVICE=ws://localhost:4008
BANK_CONTACT_CENTER=ws://localhost:4010
HEALTHCARE_CENTER=ws://localhost:4011
MOTOR_CYCLES_AGENT_URL=ws://localhost:4013
HOME_APPLIANCES_AGENT_URL=ws://localhost:4014

# ── AI / speech providers ───────────────────────────────────────────────────
AI_PROVIDER=gemini
# deepgram | google | sarvam
STT_PROVIDER=sarvam
STT_FALLBACK_PROVIDER=deepgram
TTS_PROVIDER=sarvam
INITIAL_LISTEN_DELAY_MS=3500
# Optional overrides (code defaults apply when unset)
# TRANSCRIPTION_PROVIDER=
# TRANSLATION_MODEL=
# LANGUAGE_ID_MODEL=

# Google / Gemini
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_LOCATION_US=us-central1
GOOGLE_CLOUD_LOCATION_IN=asia-south1
GOOGLE_CLOUD_STT_RECOGNIZER_ID=
GOOGLE_GENAI_USE_ENTERPRISE=True

# Deepgram
DEEPGRAM_API_KEY=
# SECOND_STT_LANGUAGE=te
# DEEPGRAM_ENDPOINTING_MS=300
# DEEPGRAM_UTTERANCE_END_MS=

# Sarvam
SARVAM_API_KEY=
SARVAM_API_KEY_2=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=unknown
# SARVAM_STT_MODE=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_PACE=1
SARVAM_TTS_TEMPERATURE=0.2

# Language switching
LANGUAGE_SWITCH_MIN_CONFIDENCE=0.8
LANGUAGE_SWITCH_MIN_WORDS=2
# LANGUAGE_SWITCH_CONFIRMATIONS=
# LANGUAGE_SWITCH_COOLDOWN_MS=

# ── Telephony: Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default caller ID (TWILIO_PHONE_NUMBER wins when both are set)
TWILIO_MOBILE_NUMBER=
# TWILIO_PHONE_NUMBER=
TWILIO_WS_URL=wss://<this-gateway-host>
TWILIO_WEBHOOK_URL=https://<this-gateway-host>

# ── Telephony: Exotel ───────────────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Default caller ID when a call has no `from`
EXOTEL_EXOPHONE=
# Public base of this gateway; streams connect to <EXOTEL_WS_URL>/exotel
EXOTEL_WS_URL=wss://<this-gateway-host>
# api.exotel.com (Singapore, default) | api.in.exotel.com (Mumbai)
# EXOTEL_API_HOST=api.in.exotel.com
# Status callbacks go to <base>/exotel/status (defaults to EXOTEL_WS_URL's host)
# EXOTEL_WEBHOOK_URL=https://<this-gateway-host>
# Stream audio rate: 8000 (default) | 16000 | 24000
# EXOTEL_SAMPLE_RATE=8000
# Set to false to send Indian numbers through Twilio instead of Exotel
# EXOTEL_ROUTE_INDIA=true
